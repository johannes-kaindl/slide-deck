{
  "sources": {
    "obsidian-kit": { "ref": "0.43.0" },
    "code-kit": { "ref": "0.7.0" }
  },
  "targets": [
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": ["endpoint-source"],
      "rewrite": [["../vendor/code-kit/pure/", "./"], ["../vendor/code-kit/web/", "./"]]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": ["endpoint", "endpoint_config", "endpoint_diagnostics", "error_body", "model-choice", "model-context", "model-list-cache", "reasoning", "sampling-profiles", "settings", { "name": "sse", "ref": "0.8.0" }, "think-splitter", "timeout"]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/web",
      "modules": ["clipboard"]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": ["chat-transport", "clock", "folder-suggest", "help-setting", "hub", "settings_walker", "stream-area"]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [{ "name": "chat-client", "ref": "0.44.0" }, "endpoint-list", "endpoint-source", "model-picker"],
      "rewrite": [["../vendor/code-kit/pure/", "../kit/"], ["../vendor/code-kit/web/", "../kit/"], ["../pure/", "../kit/"]]
    }
  ]
}
